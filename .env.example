# design (the legacy anon JWT, role=anon, the same key the website ships in its bundle);
# eas.json sets them for EAS builds. NEVER put the service-role key anywhere in this repo.
EXPO_PUBLIC_SUPABASE_URL=https://kvypmjxbbaaknvddwwai.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imt2eXBtanhiYmFha252ZGR3d2FpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk3MTM3MTIsImV4cCI6MjA5NTI4OTcxMn0.5VMp6SerPxUUnnjr-43N29pHbh6kpgJc71USvL_Ooj4

# Native Google sign-in (PLAN.md §4.3). Optional: without them the Google button hides.
# WEB = the OAuth web client Supabase's Google provider already uses; IOS = an iOS client
# in the same Google Cloud project. Both must be in Supabase → Auth → Google → Authorized Client IDs.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1075492271982-ju0k9lfhl2lim7fcu62roa6jr28eierp.apps.googleusercontent.com
